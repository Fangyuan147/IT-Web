[Unit]
Description=Ops Demo Web Application
After=network.target

[Service]
Type=simple
User=opsdemo
Group=opsdemo
WorkingDirectory=/opt/ops-demo/apps/ops-demo
ExecStart=/opt/ops-demo/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile /var/log/ops-demo/ops-demo-access.log --error-logfile /var/log/ops-demo/ops-demo-error.log app:app
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
